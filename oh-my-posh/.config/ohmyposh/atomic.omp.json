{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:blue",
          "foreground": "p:bg0",
          "leading_diamond": "\u256d\u2500\ue0b6",
          "style": "diamond",
          "template": "\uf07b {{ .Path }} ",
          "type": "path",
          "options": {
            "folder_icon": " \uf07b ",
            "home_icon": "~",
            "style": "full"
          }
        },
        {
          "background": "p:red",
          "foreground": "p:fg",
          "style": "diamond",
          "template": "<parentBackground>\ue0b0</> \uf292 ",
          "type": "root"
        },
        {
          "background": "p:green",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:orange{{ end }}",
            "{{ if gt .Ahead 0 }}p:purple{{ end }}",
            "{{ if gt .Behind 0 }}p:purple{{ end }}"
          ],
          "foreground": "p:bg0",
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_icon": "\ue725 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<p:red> \uf046 {{ .Staging.String }}</>{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "p:bg1",
          "foreground": "p:green",
          "leading_diamond": "\ue0b6",
          "options": {
            "fetch_package_manager": true,
            "npm_icon": " <#cc3a3a>\ue5fa</> ",
            "yarn_icon": " <#348cba>\ue6a7</>"
          },
          "style": "diamond",
          "template": "\ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "node"
        },
        {
          "background": "p:bg1",
          "foreground": "p:yellow",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "python"
        },
        {
          "background": "p:bg1",
          "foreground": "p:orange",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue738 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "java"
        },
        {
          "background": "p:bg1",
          "foreground": "p:purple",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue77f {{ if .Unsupported }}\uf071{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "dotnet"
        },
        {
          "background": "p:bg1",
          "foreground": "p:aqua",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "go"
        },
        {
          "background": "p:bg1",
          "foreground": "p:orange",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue7a8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "rust"
        },
        {
          "background": "p:bg1",
          "foreground": "p:blue",
          "leading_diamond": " \ue0b6",
          "style": "diamond",
          "template": "\ue798 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "dart"
        },
        {
          "background": "p:bg1",
          "foreground": "p:red",
          "leading_diamond": " \ue0b6",
          "style": "diamond",
          "template": "\ue753 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "angular"
        },
        {
          "background": "p:bg1",
          "foreground": "p:purple",
          "leading_diamond": " \ue0b6",
          "style": "diamond",
          "template": "\u03b1 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "aurelia"
        },
        {
          "background": "p:bg1",
          "foreground": "p:aqua",
          "leading_diamond": " \ue0b6",
          "style": "diamond",
          "template": "{{ if .Error }}{{ .Error }}{{ else }}Nx {{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "nx"
        },
        {
          "background": "p:bg1",
          "foreground": "p:purple",
          "leading_diamond": " \ue0b6",
          "style": "diamond",
          "template": "<p:red>\ue624</> {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "julia"
        },
        {
          "background": "p:bg1",
          "foreground": "p:red",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue791 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "ruby"
        },
        {
          "background": "p:bg1",
          "foreground": "p:blue",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\uf104<p:yellow>\uf0e7</>\uf105 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "azfunc"
        },
        {
          "background": "p:bg1",
          "foreground": "p:orange",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }}",
          "trailing_diamond": "\ue0b4 ",
          "type": "aws"
        },
        {
          "background": "p:aqua",
          "foreground": "p:bg0",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "{{ if matchP \"(?i)(^|[-_./:@])(prod|production|prd)($|[-_./:@])\" .Context }}PROD {{ end }}ctx: {{ if gt (len .Context) 36 }}{{ trunc 12 .Context }}...{{ trunc -21 .Context }}{{ else }}{{ .Context }}{{ end }} ns: {{ if .Namespace }}{{ .Namespace }}{{ else }}default{{ end }}",
          "trailing_diamond": "\ue0b4",
          "type": "kubectl",
          "alias": "Kubernetes",
          "background_templates": [
            "{{ if matchP \"(?i)(^|[-_./:@])(prod|production|prd)($|[-_./:@])\" .Context }}p:red{{ end }}"
          ]
        },
        {
          "background": "p:green",
          "background_templates": [
            "{{ if eq \"Charging\" .State.String }}p:aqua{{ end }}",
            "{{ if eq \"Discharging\" .State.String }}p:yellow{{ end }}",
            "{{ if eq \"Full\" .State.String }}p:green{{ end }}"
          ],
          "foreground": "p:bg0",
          "invert_powerline": true,
          "powerline_symbol": "\ue0b2",
          "options": {
            "charged_icon": "\uf240 ",
            "charging_icon": "\uf1e6 ",
            "discharging_icon": "\ue234 "
          },
          "style": "powerline",
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}\uf295 ",
          "type": "battery"
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "foreground": "p:yellow",
          "background": "p:bg1",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": " {{ .FormattedMs }} ",
          "options": {
            "threshold": 2000,
            "style": "austin"
          }
        },
        {
          "background": "p:bg1",
          "foreground": "p:fg",
          "invert_powerline": true,
          "leading_diamond": "\ue0b2",
          "options": {
            "time_format": "15:04"
          },
          "style": "diamond",
          "template": " \uf017 {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "\ue0b4",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:muted",
          "style": "plain",
          "template": "\u2570\u2500",
          "type": "text"
        },
        {
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "\ue285\ueab6 ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "tooltips_action": "replace",
  "tooltips": [
    {
      "type": "docker",
      "tips": [
        "docker"
      ],
      "style": "diamond",
      "foreground": "p:bg0",
      "background": "p:blue",
      "leading_diamond": "\ue0b6",
      "trailing_diamond": "\ue0b4",
      "template": " Docker ctx: {{ .Context }} ",
      "options": {
        "display_mode": "context"
      }
    },
    {
      "type": "kubectl",
      "alias": "KubernetesTip",
      "tips": [
        "kubectl",
        "k",
        "kubectx",
        "kubens",
        "k9s",
        "klogin"
      ],
      "style": "diamond",
      "foreground": "p:bg0",
      "background": "p:aqua",
      "background_templates": [
        "{{ if matchP \"(?i)(^|[-_./:@])(prod|production|prd)($|[-_./:@])\" .Context }}p:red{{ end }}"
      ],
      "leading_diamond": "\ue0b6",
      "trailing_diamond": "\ue0b4",
      "template": " {{ if matchP \"(?i)(^|[-_./:@])(prod|production|prd)($|[-_./:@])\" .Context }}PROD {{ end }}Aktivt ctx: {{ .Context }} ns: {{ if .Namespace }}{{ .Namespace }}{{ else }}default{{ end }} "
    }
  ],
  "version": 4,
  "palette": {
    "bg0": "#282828",
    "bg1": "#3c3836",
    "bg2": "#504945",
    "fg": "#ebdbb2",
    "muted": "#a89984",
    "red": "#fb4934",
    "green": "#b8bb26",
    "yellow": "#fabd2f",
    "blue": "#83a598",
    "aqua": "#8ec07c",
    "purple": "#d3869b",
    "orange": "#fe8019"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:fg",
    "template": "{{ if .Segments.Contains \"Kubernetes\" }}{{ if matchP \"(?i)(^|[-_./:@])(prod|production|prd)($|[-_./:@])\" .Segments.Kubernetes.Context }}<p:red>PROD {{ else }}<p:aqua>{{ end }}{{ .Segments.Kubernetes.Context }}:{{ if .Segments.Kubernetes.Namespace }}{{ .Segments.Kubernetes.Namespace }}{{ else }}default{{ end }}</> {{ end }}<p:green>\u276f</> "
  }
}
